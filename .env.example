# Env vars for the site and its /api functions. Production values live in the Vercel
# dashboard; locally, copy this to .env.local (gitignored) or run
# `vercel env pull .env.local`. See LOCAL_DEV.md.

# Clerk publishable key. Picks the Clerk instance for both the frontend
# (baked in at build time by scripts/build-env.mjs) and the API. Use the
# pk_test key everywhere except Production, which gets pk_live: the
# production instance only works on rileyretzloff.xyz.
CLERK_PUBLISHABLE_KEY=

# Recipes: a fine-grained PAT with Contents read/write on the repo.
# Locally, consider pointing at a throwaway repo.
GITHUB_RECIPES_TOKEN=
GITHUB_RECIPES_REPO=RileyRetzloff/recipes
# Comma-separated Clerk user IDs allowed to edit recipes. IDs differ per
# Clerk instance; /recipes/new shows yours when you're not on the list.
RECIPE_CONTRIBUTORS=

# Feedback: a fine-grained PAT with Issues read/write on the repo.
GITHUB_PSST_ISSUES_READWRITE_TOKEN=
GITHUB_PSST_ISSUES_REPO=RileyRetzloff/psst
