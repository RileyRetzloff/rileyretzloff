# Server-side environment variables for the /api functions.
#
# This file is a TEMPLATE — it lists every variable the functions read,
# with placeholders. Real values live in the Vercel dashboard
# (Project → Settings → Environment Variables), one set per scope:
# Production, Preview, Development. Local development picks up the
# Development set automatically via `vercel dev` (see LOCAL_DEV.md).
# Never commit real values; .env and .env.* are gitignored.

# --- Clerk (used by api/_lib/clerk.js to verify session tokens) ---
# The publishable key of the Clerk instance whose tokens the API should
# accept. The functions decode the instance host from this value and
# verify tokens against that instance's public JWKS. No Clerk secret
# key is used anywhere in this project.
#   Production scope: the pk_live key (matches src/environments/environment.ts)
#   Development scope: the pk_test key (matches src/environments/environment.development.ts)
CLERK_PUBLISHABLE_KEY=

# --- Recipes (api/_lib/github.js, api/_lib/recipes.js) ---
# Fine-grained GitHub PAT with Contents read/write on the recipes repo only.
GITHUB_RECIPES_TOKEN=
# The recipes repo, as "owner/repo" (not a URL).
# Note: local dev writes go to whichever repo this names in the
# Development scope. Point Development at a separate throwaway repo if
# you don't want test recipes showing up on the live site.
GITHUB_RECIPES_REPO=RileyRetzloff/recipes
# Comma-separated Clerk user IDs allowed to create/edit/delete recipes.
# IDs are per-instance: the Development set needs your DEVELOPMENT
# instance user ID, Production needs your production one. The
# /recipes/new page shows your ID when you're signed in but not listed.
RECIPE_CONTRIBUTORS=

# --- Anonymous feedback (api/feedback.js) ---
# Fine-grained GitHub PAT with Issues read/write on the psst repo only.
GITHUB_PSST_ISSUES_READWRITE_TOKEN=
# The feedback repo, as "owner/repo" (not a URL).
GITHUB_PSST_ISSUES_REPO=RileyRetzloff/psst
